{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penerjemah Arab Indonesia",
  "version": "1.0.0",
  "identifier": "com.arabindo.penerjemah",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Penerjemah Arab Indonesia - Kontekstual & Kaidah Nahwu-Sharaf",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Penerjemah Bahasa Arab ke Bahasa Indonesia Profesional",
    "longDescription": "Aplikasi penerjemah kontekstual Arab-Indonesia dengan analisis tata bahasa Nahwu-Sharaf, tasykil harakat, dan rujukan kamus otoritatif KSAA, Mujam, serta Almaany."
  }
}
